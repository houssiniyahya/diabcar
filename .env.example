# ---- Site ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://diabcar.ma
# Host that serves the admin (default: any host starting with "admin.")
ADMIN_HOST=admin.diabcar.ma
# Allow /admin/* on the public host (useful for previews). Never true in production.
ADMIN_ALLOW_PATH=false

# ---- Database / Auth (Supabase) — leave empty to run in demo mode ---------
# With both of these set, src/lib/auth/session.js -> isSupabaseConfigured()
# switches the whole app off the in-memory demo store and onto Postgres.
# Apply supabase/migrations/0001..0006 and run `npm run db:seed` FIRST,
# or every page will query tables that do not exist yet.
NEXT_PUBLIC_SUPABASE_URL=
# The publishable (anon) key. NEXT_PUBLIC_ means it is inlined into the
# JavaScript every visitor downloads — that is by design and it is NOT a
# secret. What protects customer data is RLS (supabase/migrations/0005),
# never the secrecy of this key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=   (legacy name, read only as a fallback for the key above)

# SERVER ONLY. Bypasses RLS entirely — it is the master key to the database.
# REQUIRED IN PRODUCTION at run time, not only by `npm run db:seed`: the cron
# sweeps (expired holds, unconfirmed requests, reminders) and the booking
# notifications use it. Never prefix it with NEXT_PUBLIC_, never commit it, and
# never tick it for Vercel Preview unless Preview points at a separate staging
# project. If it ever leaks, rotate it in the Supabase dashboard (Settings -> API).
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated e-mails allowed into the admin, on top of the role claim.
# The real gate is profiles.role in the JWT (plan 7.2); this is a safety net.
ADMIN_EMAILS=admin@diabcar.ma

# ---- Demo mode (no Supabase) --------------------------------------------
# Development only. A production build refuses the demo admin unless AUTH_SECRET
# is a real 32+ character secret AND the password is not this default
# (src/lib/auth/session.js). Do not set either on Vercel.
ADMIN_DEMO_PASSWORD=diabcar-demo
# Random 32+ chars, used to sign the demo session cookie
AUTH_SECRET=change-me-in-production

# ---- E-mail (Resend) ------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Diab Car <reservations@diabcar.ma>"
BOOKING_NOTIFY_EMAIL=contact@diabcar.ma

# ---- SEO / analytics --------------------------------------------------------
NEXT_PUBLIC_GA_ID=
INDEXNOW_KEY=

# ---- Cron / maintenance ---------------------------------------------------
# Shared secret for the scheduled route handlers listed in vercel.json. Vercel
# Cron sends it as `Authorization: Bearer ...` by itself. A long random string
# (for example 64 hex characters). Production only.
CRON_SECRET=

# ---- Anti-spam (Cloudflare Turnstile, free) -------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Web Push (VAPID, free) -----------------------------------------------
# NOT USED YET: Web Push is still a PROMPT 10 carry-over. Do not set these on Vercel.
# Generate once with `npm run vapid` (Web Crypto, no dependency — the sender
# runs on Cloudflare Workers where node:crypto is unavailable, CLAUDE.md rule 9).
# The PUBLIC key is not a secret: the browser needs it to subscribe.
# The PRIVATE key is — anyone holding it can push to every subscribed device.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:diabcar@gmail.com

# ---- End-to-end tests (local only; never set on Vercel) ----------------------
# The admin specs log in with a real owner account. Both must be set or those
# tests skip. Keep the values in .env.local or your shell, never in the repo.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
